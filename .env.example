# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must never be pasted into chat or committed.

# --- YouTube ---------------------------------------------------------------
# Free. console.cloud.google.com -> new project -> enable "YouTube Data API v3"
# -> Credentials -> Create API Key. Restrict it to that one API.
YOUTUBE_API_KEY=

# --- Instagram -------------------------------------------------------------
# Requires: IG account switched to Business or Creator, linked to a Facebook
# Page, plus a Meta app at developers.facebook.com.
# Short-lived tokens last 1 hour; exchange for a long-lived one (60 days).
# The 60-day expiry means this needs re-upping every couple of months.
IG_ACCESS_TOKEN=
IG_USER_ID=

# --- X / Twitter -----------------------------------------------------------
# Free tier cannot read metrics. Leave blank unless you're paying for Basic.
X_BEARER_TOKEN=

# --- TikTok ----------------------------------------------------------------
# Needs an approved developer app. Usually not worth it at this stage.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Backblaze B2 (off-site footage backup) --------------------------------
# backblaze.com -> B2 Cloud Storage -> Application Keys -> Add a New
# Application Key. Scope it to the ONE bucket, not the whole account.
#
# B2_ACCOUNT_ID is the "keyID" shown when the key is created - NOT your
# account's master key, and NOT the numeric account ID on the profile page.
# B2_APPLICATION_KEY is shown exactly once. If you lose it, make a new key.
#
# Bucket names are globally unique across all of B2, so plain "footage" is
# taken. Use something like projectmc-footage-archive.
B2_ACCOUNT_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
