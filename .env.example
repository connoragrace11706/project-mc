# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must never be pasted into chat or committed.

# --- YouTube ---------------------------------------------------------------
# Free. console.cloud.google.com -> new project -> enable "YouTube Data API v3"
# -> Credentials -> Create API Key. Restrict it to that one API.
YOUTUBE_API_KEY=

# --- Instagram -------------------------------------------------------------
# Requires: IG account switched to Business or Creator, linked to a Facebook
# Page, plus a Meta app at developers.facebook.com.
# Short-lived tokens last 1 hour; exchange for a long-lived one (60 days).
# The 60-day expiry means this needs re-upping every couple of months.
IG_ACCESS_TOKEN=
IG_USER_ID=

# --- X / Twitter -----------------------------------------------------------
# Free tier cannot read metrics. Leave blank unless you're paying for Basic.
X_BEARER_TOKEN=

# --- TikTok ----------------------------------------------------------------
# Needs an approved developer app. Usually not worth it at this stage.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
